    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && (isPortalOrAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid));
      allow list: if isPortalOrAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if isPortalOrVerified() && isValidId(notifId) && isValidNotification(incoming()) &&
        incoming().id == notifId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isPortalOrAdmin() || (incoming().senderUid == request.auth.uid && incoming().isRead == false));
      allow update: if isPortalOrVerified() && isValidId(notifId) && isValidNotification(incoming()) &&
        incoming().id == existing().id &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().senderUid == existing().senderUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPortalOrAdmin() ||
          (existing().recipientUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
        );
      allow delete: if isPortalOrAdmin() && isValidId(notifId);
    }

    match /chatConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isPortalOrVerified();
      allow list: if isPortalOrVerified();
      allow create: if isPortalOrVerified() && isValidId(conversationId) && isValidChatConversation(incoming()) &&
        incoming().id == conversationId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isPortalOrAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isPortalOrVerified() && isValidId(conversationId) && isValidChatConversation(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'department', 'participantEmployeeIds', 'participantUids',
          'isDefaultGroup', 'lastMessageText', 'lastMessageSenderId',
          'lastMessageSenderName', 'lastMessageAt', 'updatedAt'
        ]);
      allow delete: if isPortalOrAdmin() && isValidId(conversationId);
    }

    match /chatMessages/{messageId} {
      allow get: if isValidId(messageId) && isPortalOrVerified();
      allow list: if isPortalOrVerified();
      allow create: if isPortalOrVerified() && isValidId(messageId) && isValidChatMessage(incoming()) &&
        incoming().id == messageId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isPortalOrAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isPortalOrVerified() && isValidId(messageId) && isValidChatMessage(incoming()) &&
        incoming().id == existing().id &&
        incoming().conversationId == existing().conversationId &&
        incoming().senderEmployeeId == existing().senderEmployeeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['text', 'readByEmployeeIds', 'updatedAt']);
      allow delete: if isPortalOrAdmin() && isValidId(messageId);
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isPortalOrAdmin();
      allow list: if isPortalOrAdmin();
      allow create: if isPortalOrVerified() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().createdAt == request.time &&
        (isPortalOrAdmin() || incoming().actorUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isPortalOrVerified() && settingId in ['attendancePolicy', 'institutionalLeavePolicy'];
      allow list: if isPortalOrAdmin();
      allow create: if isPortalOrAdmin() && isValidId(settingId) &&
        settingId in ['attendancePolicy', 'institutionalLeavePolicy'] &&
        isValidSettingDoc(incoming(), settingId) &&
        incoming().updatedAt == request.time;
      allow update: if isPortalOrAdmin() && isValidId(settingId) &&
        settingId in ['attendancePolicy', 'institutionalLeavePolicy'] &&
        isValidSettingDoc(incoming(), settingId) &&
        incoming().settingType == existing().settingType &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'officeStartTime', 'officeEndTime', 'gracePeriodMinutes',
          'lateThresholdMinutes', 'earlyLeaveThresholdMinutes', 'breakDurationMinutes',
          'weeklyHolidays', 'specialDays', 'campusLat', 'campusLng',
          'geofenceRadiusMeters', 'qrRotationSeconds', 'requireGpsVerification',
          'autoSyncIntervalMinutes', 'institutionLogoUrl', 'year', 'academicYearLabel',
          'casualLeaveEnabled', 'casualLeaveDefault', 'sickLeaveEnabled',
          'sickLeaveDefault', 'earnedLeaveEnabled', 'earnedLeaveDefault',
          'dutyLeaveEnabled', 'hijriOffsetDays', 'updatedBy', 'updatedByUid', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
