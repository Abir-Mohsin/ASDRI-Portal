            ]) &&
            isValidOptionalNumber(data, 'year', 2020, 2100) &&
            isValidOptionalString(data, 'academicYearLabel', 100) &&
            isValidOptionalBool(data, 'casualLeaveEnabled') &&
            isValidOptionalNumber(data, 'casualLeaveDefault', 0, 365) &&
            isValidOptionalBool(data, 'sickLeaveEnabled') &&
